{
  "_comment": "gsd-lite の無人ターン (claude -p) 用 allowlist の雛形。init がプロジェクトの .claude/settings.json にマージする。テストランナー等はプロジェクトに合わせて調整すること。",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git remote:*)",
      "Bash(gh pr create:*)",
      "Bash(gh auth status:*)",
      "Bash(glab mr create:*)",
      "Bash(glab auth status:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(date:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "WebSearch",
      "WebFetch(domain:*)",
      "Read(~/workspaces/**)"
    ]
  }
}
